# OpenAI or Mistral. Without a working key the game runs its built-in show.
# Voice is only used with RIZZTRAL_TTS=1.
MISTRAL_API_KEY=
OPENAI_API_KEY=
# Optional: force a provider (openai | mistral) and override models
# RIZZTRAL_PROVIDER=mistral
# RIZZTRAL_MODEL_CLARISSA=gpt-5.4-mini
# RIZZTRAL_MODEL_JACQUES=gpt-5.4-mini
# RIZZTRAL_MODEL_BRAD=gpt-5.4-nano
# RIZZTRAL_TTS=1  # opt-in OpenAI voice (costs extra)
# RIZZTRAL_MAX_AI_GAMES_PER_DAY=40  # 0 = no cap
# RIZZTRAL_DEMO=1  # Run the full game locally without any AI provider calls
